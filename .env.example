# Model provider: "openai" or "azure"
LM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
# Azure OpenAI (only when LM_PROVIDER=azure)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Web search
SERPER_API_KEY=

# Models (deployment names on Azure)
EMBEDDING_MODEL_NAME=text-embedding-3-large
RAG_MODEL_NAME=gpt-4.1-mini
PLANNING_MODEL_NAME=gpt-4.1-mini
SYNTHESIS_MODEL_NAME=gpt-5-chat
